// Browser code, bundled by Vite.
// package.json keeps the project non-empty before its first source file exists, so `tsc -b` passes on an empty workspace.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "node_modules/.cache/tsc/app",
    "tsBuildInfoFile": "node_modules/.cache/tsc/app/tsconfig.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "package.json"],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/domain"
    }
  ]
}

// Root configuration files and scripts.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "node_modules/.cache/tsc/tooling",
    "tsBuildInfoFile": "node_modules/.cache/tsc/tooling/tsconfig.tsbuildinfo",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["*.ts", "*.js", "scripts"],
  // scripts/dev-env.ts imports isLoopbackHost from packages/db/src/settings.ts.
  "references": [{ "path": "packages/db" }]
}

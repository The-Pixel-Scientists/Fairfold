# PixelGrant environment variables
#
# Every variable PixelGrant reads is listed here, with an empty value. In
# development you need no .env file: the development commands (`pnpm
# db:migrate`, `pnpm db:rollback`, `pnpm db:drop`, `pnpm test` and `pnpm
# test:db`) fill in each value from infra/compose/compose.dev.yaml and this
# worktree's names (`pnpm dev:names`). Each command receives only the
# variables it needs (scripts/dev-env.ts). To override one, copy this file to
# .env and set only that variable; empty values are ignored.
#
# Never put a real credential in this file, and never commit a .env file.
# Every *_PASSWORD variable can instead be given as a file, for example a
# Compose or Kubernetes secret: set the same name with _FILE on the end, such
# as PIXELGRANT_DB_MIGRATOR_PASSWORD_FILE=/run/secrets/db_migrator_password.
# Setting both forms is an error.

# --- Development -------------------------------------------------------------

# Set to 1 by the development commands. Lets development-only actions run,
# such as dropping a database, and lets the roles script accept the fixed
# development passwords. Never set it in a real install.
PIXELGRANT_DEV=

# This worktree's own databases, which `pnpm db:drop` may drop. The
# development commands set it from the worktree's folder name, and it cannot
# be overridden; it is listed here only for completeness.
PIXELGRANT_DEV_DATABASES=

# --- Database ------------------------------------------------------------------

# PostgreSQL server. Development: 127.0.0.1 and 55432.
PIXELGRANT_DB_HOST=
PIXELGRANT_DB_PORT=

# This worktree's database and test database. Development:
# pixelgrant_<worktree> and pixelgrant_<worktree>_test.
PIXELGRANT_DB_NAME=
PIXELGRANT_TEST_DB_NAME=

# A superuser, used only to create the database and run the roles script
# (packages/db/scripts/roles.sql) before migrating, and by the tests of that
# script. Nothing else receives it.
PIXELGRANT_DB_SUPERUSER=
PIXELGRANT_DB_SUPERUSER_PASSWORD=

# Passwords for the database roles (ADR 0003). The roles script sets them;
# each process receives only its own. At least 16 characters of printable
# ASCII. Outside development, the fixed development passwords are refused.
#   migrator    the migrate job, and nothing else
#   app_api     the API
#   app_worker  job handlers in the worker
#   app_auth    apps/api/src/auth only
#   app_queue   pg-boss's own connection in the worker
PIXELGRANT_DB_MIGRATOR_PASSWORD=
PIXELGRANT_DB_APP_API_PASSWORD=
PIXELGRANT_DB_APP_WORKER_PASSWORD=
PIXELGRANT_DB_APP_AUTH_PASSWORD=
PIXELGRANT_DB_APP_QUEUE_PASSWORD=

# --- Continuous integration ------------------------------------------------------

# Set by CI services. Makes Playwright retry failed tests and refuse test.only.
CI=
